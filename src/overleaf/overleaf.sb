(version 1)
(deny default)
(import "system.sb")
(allow file-read* file-map-executable process-exec process-fork sysctl-read)
(allow signal (target self))
(allow network-outbound (remote ip) (literal "/private/var/run/mDNSResponder"))
(allow system-socket (socket-domain AF_SYSTEM))
(allow mach-lookup
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration")
    (global-name "com.apple.system.opendirectoryd.libinfo")
    (global-name "com.apple.trustd.agent"))
(allow file-write* (subpath (param "WORKSPACE")) (subpath (param "STATE")))
(allow file-write-data (literal "/dev/null"))
